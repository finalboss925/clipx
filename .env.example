# Copy to .env; local operation needs no paid API keys.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_PUBLISHING=0
# Optional Postgres: postgresql+psycopg://user:password@host/clipx
# DATABASE_URL=sqlite:////app/data/clipx.db
TRANSCRIPTION_USD_PER_MINUTE=0.006
LLM_INPUT_USD_PER_MILLION=0.15
LLM_OUTPUT_USD_PER_MILLION=0.60
